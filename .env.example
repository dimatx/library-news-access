# Library card (required)
LNA_CARD_NUMBER=
LNA_CONNECT_BASE=https://mhl.org/connect

# Your existing newspaper account. The Globe's form is labelled "Create
# Account", but submitting it for an account that already exists is the
# intended way to re-up access -- use your real Globe login here.
LNA_FIRST_NAME=
LNA_LAST_NAME=
LNA_EMAIL=
LNA_PASSWORD=

# Scheduling. The Globe grants 72 hours, so a 24h renewal leaves two full
# retries of headroom before access could actually lapse.
LNA_CHECK_MINUTES=30
LNA_RENEW_MARGIN_HOURS=24
LNA_RUN_ON_START=true

# Comma-separated provider ids to run. Empty = whatever is enabled in
# providers.json (by default: boston_globe only).
LNA_ONLY_PROVIDERS=

# MQTT / Home Assistant (optional). Leave MQTT_HOST empty to disable.
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BASE_TOPIC=library/news-access
HA_DISCOVERY_PREFIX=homeassistant

# ntfy alert on failure (optional)
LNA_NTFY_URL=
LNA_NTFY_TOPIC=
LNA_NTFY_USERNAME=
LNA_NTFY_PASSWORD=
LNA_NTFY_TOKEN=

# Uptime Kuma push monitor (optional)
LNA_KUMA_PUSH_URL=

LNA_LOG_LEVEL=INFO
